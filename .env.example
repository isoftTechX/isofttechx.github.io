# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash)
VITE_SITE_URL=https://isofttechx.github.io
# Contact form: a POST endpoint that accepts JSON (e.g. Formspree, your own serverless function)
VITE_CONTACT_ENDPOINT=
# Optional public contact address. Leave empty to hide it.
VITE_CONTACT_EMAIL=
# Optional real social URLs. Leave empty to hide.
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=
